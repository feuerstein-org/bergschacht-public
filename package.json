    "eslint-plugin-jsdoc": "^63.3.3",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^3.2.7"
  },
  "dependencies": {
