{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Version Manifest Schema",
  "description": "Schema for managing artifact versions per repository with multiple named artifacts (images and lambdas) per repository",
  "type": "object",
  "required": ["schemaVersion", "repositories"],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON Schema reference"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semantic version of the manifest schema"
    },
    "repositories": {
      "type": "object",
      "description": "Map of repository names to their deployment configurations",
      "patternProperties": {
        "^[a-zA-Z0-9-_]+$": {
          "type": "object",
          "description": "Repository with one or more named artifacts",
          "required": ["source"],
          "properties": {
            "source": {
              "type": "string",
              "description": "Source repository (owner/repo) that produces this package"
            },
            "images": {
              "type": "object",
              "description": "Map of named container image artifacts",
              "patternProperties": {
                "^[a-zA-Z0-9-_]+$": {
                  "$ref": "#/$defs/containerArtifact"
                }
              },
              "additionalProperties": false
            },
            "lambdas": {
              "type": "object",
              "description": "Map of named Lambda artifacts",
              "patternProperties": {
                "^[a-zA-Z0-9-_]+$": {
                  "$ref": "#/$defs/lambdaArtifact"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "lambdaArtifact": {
      "type": "object",
      "required": ["bucket", "key", "version", "commitSha"],
      "properties": {
        "bucket": {
          "type": "string",
          "description": "S3 bucket containing the Lambda artifact"
        },
        "key": {
          "type": "string",
          "description": "S3 object key (path to zip file)"
        },
        "version": {
          "type": "string",
          "description": "Semantic version of the artifact"
        },
        "commitSha": {
          "type": "string",
          "pattern": "^[a-f0-9]{7,40}$",
          "description": "Git commit SHA that produced this artifact"
        }
      },
      "additionalProperties": false
    },
    "containerArtifact": {
      "type": "object",
      "required": ["repository", "imageTag", "version", "commitSha"],
      "properties": {
        "repository": {
          "type": "string",
          "description": "Full ECR repository URI"
        },
        "imageTag": {
          "type": "string",
          "description": "Docker image tag"
        },
        "version": {
          "type": "string",
          "description": "Semantic version of the artifact"
        },
        "commitSha": {
          "type": "string",
          "pattern": "^[a-f0-9]{7,40}$",
          "description": "Git commit SHA that produced this image"
        }
      },
      "additionalProperties": false
    }
  }
}
