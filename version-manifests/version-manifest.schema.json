{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Version Manifest Schema",
  "description": "Schema for managing package versions with multiple deployment types per package",
  "type": "object",
  "required": ["schemaVersion", "packages"],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON Schema reference"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semantic version of the manifest schema"
    },
    "packages": {
      "type": "object",
      "description": "Map of package names to their deployment configurations",
      "patternProperties": {
        "^[a-zA-Z0-9-_]+$": {
          "type": "object",
          "description": "Package with one or more deployment types",
          "properties": {
            "lambda": {
              "$ref": "#/$defs/lambdaArtifact",
              "description": "Lambda deployment configuration"
            },
            "image": {
              "$ref": "#/$defs/containerArtifact",
              "description": "Container image deployment configuration"
            }
          },
          "minProperties": 1,
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "lambdaArtifact": {
      "type": "object",
      "required": ["bucket", "key", "version", "commitSha"],
      "properties": {
        "bucket": {
          "type": "string",
          "description": "S3 bucket containing the Lambda artifact"
        },
        "key": {
          "type": "string",
          "description": "S3 object key (path to zip file)"
        },
        "version": {
          "type": "string",
          "description": "Semantic version of the package"
        },
        "commitSha": {
          "type": "string",
          "pattern": "^[a-f0-9]{7,40}$",
          "description": "Git commit SHA that produced this artifact"
        }
      },
      "additionalProperties": false
    },
    "containerArtifact": {
      "type": "object",
      "required": ["repository", "imageTag", "version", "commitSha"],
      "properties": {
        "repository": {
          "type": "string",
          "description": "Full ECR repository URI"
        },
        "imageTag": {
          "type": "string",
          "description": "Docker image tag"
        },
        "version": {
          "type": "string",
          "description": "Semantic version of the package"
        },
        "commitSha": {
          "type": "string",
          "pattern": "^[a-f0-9]{7,40}$",
          "description": "Git commit SHA that produced this image"
        }
      },
      "additionalProperties": false
    }
  }
}
